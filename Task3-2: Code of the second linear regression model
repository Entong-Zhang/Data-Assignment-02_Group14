#run this file in Stata
*regression on real wage and productivity calculated by RGDP
gen prod = RGDP/employ*hrs
gen lnprod=ln(prod)
gen rwage = wage/(1+price)
gen lnrwage=ln(rwage)

reg lnrwage lnprod
est store m1

*regression on wage and productivity calculating productivity by nominal GDP
gen prod1 = GDP/employ*hrs
gen lnprod1 = ln(prod1)

reg lnwage lnprod1
est store m2

local mm "m1 m2" 
esttab `mm' using "task3-2.rtf", ///
mtitle(`mm') se b(%6.4f) s(N r2) compress nogaps /// 
star(* 0.1 ** 0.05 *** 0.01) replace
